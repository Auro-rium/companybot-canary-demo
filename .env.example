# Backboard API key (server-side only; never expose to browser or commit)
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL_NAME=openai/gpt-5.6-luna
BACKBOARD_TIMEOUT_SECONDS=60
# Optional shared bearer token for real chat requests. Canary sets the same
# value as its server-side TARGET_API_KEY; never expose it to a browser.
COMPANYAGENT_API_KEY=
# Maximum model-backed requests per client IP per minute (0 disables the cap).
COMPANYAGENT_RATE_LIMIT_PER_MINUTE=30
# Comma-separated browser origins; empty disables cross-origin browser access.
COMPANYAGENT_CORS_ORIGINS=
# Canary sends this header during target ownership verification.
CANARY_TARGET_VERIFICATION_TOKEN=
