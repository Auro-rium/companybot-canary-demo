AWS_DEFAULT_REGION=us-west-2
TARGET_MODEL_ID=us.amazon.nova-pro-v1:0
# Canary sends this header during target ownership verification.
CANARY_TARGET_VERIFICATION_TOKEN=
# Keep the safe profile in the trusted deployment. The demo PR changes code,
# not a secret, to introduce the vulnerable behavior.
COMPANYBOT_SECURITY_PROFILE=safe

